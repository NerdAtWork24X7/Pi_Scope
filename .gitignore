# Dependencies
node_modules/

# Python
.venv/
__pycache__/
*.pyc

# Agent / working state
.pi/
.pi_memory/
# Per-project plugin state (project-scoped plugin stores live here)
.pi-scope/
tmp/
.env

# Editor & OS
.DS_Store
.idea/
*.log
db/scope.db
db/scope.db-shm
db/scope.db-wal

# Build / release artifacts
apps/scope-desktop/server-bundle/
apps/scope-desktop/dist/
apps/scope-desktop/node-portable/

# apps/scope-desktop/pi-bundle/ is only a template (package.json + lock) and the
# seed a release build pre-installs (node_modules is ignored by the pattern
# above) so a packaged app can create ~/.pi-scope/pi offline. This one file is a
# build artifact build-release.sh drops in — never committed.
apps/scope-desktop/pi-bundle/pi-scope.ts

squashfs-root/

# Machine-specific desktop launcher shortcuts (Exec/Icon must be absolute
# paths, so these are generated per-machine and never committed)
Pi Scope.desktop
apps/scope-desktop/pi-scope.desktop

# Per-machine launcher settings (may pin SCOPE_HOST=0.0.0.0 / a fixed token)
apps/scope-desktop/scope.env
