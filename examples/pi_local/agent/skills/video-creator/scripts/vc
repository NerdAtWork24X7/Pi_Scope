#!/usr/bin/env bash
# Launcher: uses Pi Scope's shared Python venv (bootstrapping it on first run)
# and forwards all args to video.py.
set -euo pipefail
SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The one venv every Python-dependent element shares. Derive its base from the
# agent dir (PI_CODING_AGENT_DIR is set by Pi Scope's shim; a global `pi` uses
# ~/.pi/agent by default) so the same launcher works under either. The
# interpreter lives in bin/ on POSIX but Scripts/ on Windows.
AGENT_DIR="${PI_CODING_AGENT_DIR:-${SCOPE_AGENT_DIR:-$HOME/.pi/agent}}"
VENV="${SCOPE_PYTHON_VENV:-$(dirname "$AGENT_DIR")/.venv}"
if [ -x "$VENV/Scripts/python.exe" ]; then
  PY="$VENV/Scripts/python.exe"
else
  PY="$VENV/bin/python"
fi

if [ ! -x "$PY" ]; then
  echo "→ first run: bootstrapping the shared video-creator toolchain" >&2
  "$SKILL_DIR/scripts/setup.sh" >&2
fi
exec "$PY" "$SKILL_DIR/scripts/video.py" "$@"
